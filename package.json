{
  "name": "@tuwaio/siwx-monorepo",
  "version": "0.0.1",
  "private": true,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "packageManager": "pnpm@12.6.0",
  "description": "Monorepo for SIWX (Sign-In With X), the Stage 1 authentication layer of the TUWA ecosystem: headless, framework-agnostic CAIP-122 sign-in for EVM and Solana (L1 core + L2 chain, React and server packages).",
  "scripts": {
    "build": "pnpm --filter \"./packages/**\" build",
    "postinstall": "pnpm build",
    "lint": "eslint . --ext .ts,.tsx",
    "format": "prettier --write .",
    "lint:fix": "eslint . --fix --ext .ts,.tsx",
    "test": "pnpm --filter \"./packages/**\" test",
    "test:coverage": "pnpm --filter \"./packages/**\" test:coverage",
    "clean": "find . -name node_modules -type d -prune -exec rm -rf '{}' + && find . -name dist -type d -prune -exec rm -rf '{}' + && rm -rf .turbo",
    "docs:gen": "typedoc && cp apps/docs/typedoc/packages-meta.tsx apps/docs/src/content/packages/_meta.tsx && cp -R apps/docs/typedoc/meta/. apps/docs/src/content/packages/",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/siwx.git"
  },
  "homepage": "https://github.com/TuwaIO/siwx",
  "bugs": {
    "url": "https://github.com/TuwaIO/siwx/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@vitest/coverage-v8": "^5.0.2",
    "@vitest/ui": "^5.0.2",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "semantic-release": "^25.0.9",
    "typedoc": "^0.28.20",
    "typedoc-plugin-markdown": "^4.13.1",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  }
}
