{
  "name": "@tuwaio/siwx-solana",
  "version": "0.4.0",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "L2 Solana package of SIWX (TUWA): CAIP-122 signer for Wallet Standard and @solana/kit wallets, and ed25519 signature verification with Web Crypto, built on @solana/kit.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "tuwa",
    "siwx",
    "sign-in-with-x",
    "caip-122",
    "authentication",
    "web3",
    "solana",
    "ed25519",
    "@solana/kit",
    "wallet-standard",
    "typescript",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/siwx.git",
    "directory": "packages/siwx-solana"
  },
  "homepage": "https://github.com/TuwaIO/siwx",
  "bugs": {
    "url": "https://github.com/TuwaIO/siwx/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@tuwaio/siwx-core": "workspace:*",
    "@wallet-standard/base": ">=1.1.1",
    "@solana/kit": ">=8.2"
  },
  "devDependencies": {
    "@tuwaio/siwx-core": "workspace:*",
    "@wallet-standard/base": "^1.1.1",
    "@solana/kit": "^8.3.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3"
  }
}
