{
  "name": "@tuwaio/siwx-solana",
  "version": "0.2.1",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "Layer 2 (L2) of the TUWA Ecosystem. Solana adapter for @tuwaio/siwx. Signs and verifies CAIP-122 messages for Solana via gill and @wallet-standard using ed25519 cryptography.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "web3",
    "typescript",
    "caip-122",
    "solana",
    "ed25519",
    "gill",
    "wallet-standard",
    "sign-in-with-solana",
    "authentication",
    "tuwa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/siwx.git",
    "directory": "packages/siwx-solana"
  },
  "homepage": "https://github.com/TuwaIO/siwx",
  "bugs": {
    "url": "https://github.com/TuwaIO/siwx/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@tuwaio/siwx-core": "workspace:*",
    "@wallet-standard/base": "^1.0.0",
    "gill": "^0.14.0"
  },
  "devDependencies": {
    "@tuwaio/siwx-core": "workspace:*",
    "@wallet-standard/base": "^1.1.1",
    "gill": "^0.14.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  }
}
