{
  "name": "@tuwaio/siwx-server",
  "version": "0.7.1",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "L2 server package of SIWX (TUWA): backend verification of CAIP-122 sign-ins for EVM and Solana, single-use nonce and session stores, HttpOnly cookie helpers, Next.js App Router handlers, and JWT/JWKS for external auth providers.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.mts",
        "default": "./dist/next.mjs"
      },
      "require": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.js"
      }
    }
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "tuwa",
    "siwx",
    "sign-in-with-x",
    "caip-122",
    "authentication",
    "web3",
    "server",
    "session",
    "cookie",
    "nonce",
    "jwt",
    "jwks",
    "nextjs",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/siwx.git",
    "directory": "packages/siwx-server"
  },
  "homepage": "https://github.com/TuwaIO/siwx",
  "bugs": {
    "url": "https://github.com/TuwaIO/siwx/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@tuwaio/orbit-core": ">=0.5",
    "@tuwaio/siwx-core": ">=0.5",
    "@tuwaio/siwx-evm": ">=0.5",
    "@tuwaio/siwx-solana": ">=0.4.2",
    "viem": ">=2"
  },
  "peerDependenciesMeta": {
    "@tuwaio/siwx-evm": {
      "optional": true
    },
    "@tuwaio/siwx-solana": {
      "optional": true
    },
    "viem": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tuwaio/orbit-core": "^0.5.0",
    "@tuwaio/siwx-core": "workspace:*",
    "@tuwaio/siwx-evm": "workspace:*",
    "@tuwaio/siwx-solana": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "viem": "^2.57.1"
  }
}
