{
  "name": "@tuwaio/siwx-server",
  "version": "0.0.1",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "Backend utilities for @tuwaio/siwx (L2). Parses, validates, and verifies CAIP-122 payloads (EVM + Solana) on Node.js or Edge runtimes. Backend-agnostic — can be used with any framework.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "web3",
    "typescript",
    "caip-122",
    "server",
    "backend",
    "node",
    "edge",
    "authentication",
    "verification",
    "session",
    "cookie",
    "jwt",
    "tuwa"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/siwx.git",
    "directory": "packages/siwx-server"
  },
  "homepage": "https://github.com/TuwaIO/siwx",
  "bugs": {
    "url": "https://github.com/TuwaIO/siwx/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@tuwaio/siwx-core": "workspace:*"
  },
  "devDependencies": {
    "@tuwaio/siwx-core": "workspace:*",
    "@tuwaio/siwx-evm": "workspace:*",
    "@tuwaio/siwx-solana": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "viem": "^2.55.11"
  }
}
