{
  "name": "@tuwaio/siwx-evm",
  "version": "0.4.2",
  "private": false,
  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "L2 EVM package of SIWX (TUWA): CAIP-122 signer for wagmi and viem wallets, and EIP-191 (EOA) and EIP-1271 (smart contract wallet) signature verification, built on viem and @wagmi/core.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "tuwa",
    "siwx",
    "sign-in-with-x",
    "caip-122",
    "siwe",
    "authentication",
    "web3",
    "evm",
    "eip155",
    "eip-191",
    "eip-1271",
    "viem",
    "wagmi",
    "typescript",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/siwx.git",
    "directory": "packages/siwx-evm"
  },
  "homepage": "https://github.com/TuwaIO/siwx",
  "bugs": {
    "url": "https://github.com/TuwaIO/siwx/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@tuwaio/siwx-core": ">=0.4.1",
    "@wagmi/core": ">=3",
    "viem": ">=2"
  },
  "devDependencies": {
    "@tuwaio/siwx-core": "workspace:*",
    "@wagmi/core": "^3.6.5",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "viem": "^2.57.1"
  }
}
