  "author": "Oleksandr Tkach",
  "license": "Apache-2.0",
  "description": "L2 React package of SIWX (TUWA): useSiwx and useSiwxSession hooks with a zustand session store for the CAIP-122 sign-in flow, plus Satellite Connect helpers.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "socket.json"
  ],
  "scripts": {
    "start": "tsup src/index.ts --watch",
    "build": "tsup",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "tuwa",
    "siwx",
    "sign-in-with-x",
    "caip-122",
    "authentication",
