    "react",
    "hooks",
    "zustand",
    "typescript",
    "headless"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TuwaIO/siwx.git",
    "directory": "packages/siwx-react"
  },
  "homepage": "https://github.com/TuwaIO/siwx",
  "bugs": {
    "url": "https://github.com/TuwaIO/siwx/issues"
  },
  "contributors": [
    {
      "name": "Oleksandr Tkach",
      "url": "https://github.com/Argeare5"
    }
  ],
  "peerDependencies": {
    "@tuwaio/orbit-core": ">=0.5",
    "@tuwaio/siwx-core": ">=0.5",
    "immer": ">=11.0.0",
    "react": ">=19.2.3",
    "zustand": ">=5.0.0"
  },
  "devDependencies": {
    "@tuwaio/orbit-core": "^0.5.0",
    "@tuwaio/siwx-core": "workspace:*",
    "@types/react": "^19",
    "immer": "^11.1.18",
    "react": "^19.3.0",
    "tsup": "^8.5.1",
    "typescript": "6.0.3",
    "zustand": "^5.0.15"
  }
